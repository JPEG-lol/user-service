# Ignore node_modules, as they will be installed inside the container
node_modules

# Ignore build output
dist

# Ignore local environment files - these should be passed in at runtime
.env
.env.*

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore git and docker files
.git
.gitignore
Dockerfile
.dockerignore

# Ignore IDE and OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.DS_Store